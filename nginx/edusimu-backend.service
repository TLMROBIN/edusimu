[Unit]
Description=EduSimu Backend API Service
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/edusimu/backend
Environment="PATH=/var/www/edusimu/backend/venv/bin"
ExecStart=/var/www/edusimu/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target